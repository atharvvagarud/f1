# =========================
# FastF1 caches (NOT version-controlled)
# =========================
# /.fastf1_cache/ is the runtime HTTP cache. /data/raw/fastf1_cache/ holds
# reproducible .ff1pkl session blobs (removed from the index in R7; the
# baseline commit retains them historically). Both stay local-only so the
# working tree runs offline; neither belongs in Git or Git LFS.
# Processed datasets (data/processed, data/interim) remain tracked.
/.fastf1_cache/
/data/raw/fastf1_cache/

# =========================
# V2 canonical data (generated, NOT version-controlled)
# =========================
# data/v2/ holds manifests, interim frames and canonical Parquet built by
# the Phase-1 pipeline (D3+). All generated: reproducible from source via
# versioned ingestion, never hand-edited, never committed. V2 *code*
# (v2/*.py) and contract tests remain tracked.
# data/processed + data/interim (legacy baseline) remain tracked.
/data/v2/

# =========================
# Temporary files
# =========================
*.tmp
*.bak
*.swp
*~

# =========================
# Intentional artifacts (do NOT ignore)
# =========================
# data/processed, data/interim (but NOT data/raw/fastf1_cache/),
# results/models, results subdirectories and
# tests/fixtures/legacy_predictions.json are part of the
# R0 baseline and must remain tracked. Do not add *.pkl,
# *.csv or data/ exclusions here without an artifact-policy
# update in docs/V2_REPOSITORY_AUDIT.md.

# graphify's local knowledge graph — regenerable, not committed
# (run `graphify extract . --code-only` to rebuild, `graphify update .`
# after code changes). 15 MB generated output stays local.
graphify-out/

# Phase-5 R3 generated replay prediction checkpoints — reproducible via
# scripts/build_replay_prediction_cache.py, not committed (tens of MB for
# the full 2018–2024 backfill). Small deterministic test fixtures, if ever
# needed under tests/, are exempt from this rule.
results/v2_replay/

# Phase-8 E3 generated global explanation artifact — reproducible via
# `python -m v2.explainability`, not committed (generated, not source).
results/v2_explainability/
